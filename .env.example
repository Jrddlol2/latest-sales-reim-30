ALLOWED_ORIGINS=
# Master kill switch for every demo-only surface and seed. Keep true while
# presenting/testing; set false at production cutover.
DEMO_MODE=true
AUTH_MODE=demo
ENABLE_DEMO_LOGIN=true
VITE_ENABLE_DEMO_LOGIN=true
AUTO_SEED=true
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
SESSION_SECRET=
# Supabase/Postgres connection string. Use the SESSION POOLER connection
# (not the direct db.*.supabase.co host — IPv6-only, fails to resolve on
# many networks; not the transaction pooler, which this app doesn't need
# since it runs as one persistent process). See README.md's "Database
# persistence" section. Leave unset to run fully in-memory (no persistence).
DATABASE_URL=
GRAPH_SCOPES=
